# ==============================================================================
# BAN KAI PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure for your environment.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# --- APPLICATION & SECURITY ---
APP_NAME="BAN KAI Multi-Agent Platform"
APP_ENV="development" # development | staging | production
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="bankai-super-secret-development-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- SERVER HOST & PORT ---
HOST="0.0.0.0"
PORT=8000

# --- DATABASE & STORAGE ---
# PostgreSQL 16 with pgvector extension
DATABASE_URL="postgresql+asyncpg://bankai:bankai_secret@localhost:5432/bankai_db"
# Fallback local SQLite database for instant zero-dependency testing / offline mode
SQLITE_FALLBACK_URL="sqlite+aiosqlite:///./bankai_dev.db"
USE_SQLITE_FALLBACK=true

# --- REDIS (CACHE & TASK QUEUE) ---
REDIS_URL="redis://localhost:6379/0"
USE_REDIS_CACHE=false

# --- AI MODEL PROVIDERS ---
# Primary provider options: "openai" | "gemini" | "ollama" | "anthropic" | "mock"
DEFAULT_LLM_PROVIDER="mock"
DEFAULT_FAST_MODEL="gpt-4o-mini"
DEFAULT_SMART_MODEL="gpt-4o"
DEFAULT_EMBEDDING_PROVIDER="mock" # "openai" | "fastembed" | "mock"
DEFAULT_EMBEDDING_MODEL="text-embedding-3-small"

# Provider API Keys (leave empty to use local / mock fallback)
OPENAI_API_KEY=""
OPENAI_API_BASE=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# --- SEARCH PROVIDERS ---
# Options: "duckduckgo" | "searxng" | "tavily" | "mock"
DEFAULT_SEARCH_PROVIDER="duckduckgo"
TAVILY_API_KEY=""
SEARXNG_URL="http://localhost:8080"
MAX_SEARCH_RESULTS_PER_QUERY=5

# --- WEB CRAWLER & SCRAPING ---
CRAWLER_HEADLESS=true
CRAWLER_TIMEOUT_MS=15000
MAX_CONCURRENT_CRAWLS=4
ENABLE_JAVASCRIPT_SCRAPING=true

# --- EXECUTION ENGINE & CODE SANDBOX ---
# Options: "local_restricted" | "e2b"
SANDBOX_MODE="local_restricted"
E2B_API_KEY=""
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=512
ARTIFACT_STORAGE_DIR="./storage/artifacts"
SCRATCH_STORAGE_DIR="./storage/scratch"

# --- OBSERVABILITY & TELEMETRY ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
LOG_LEVEL="INFO"
LOG_FORMAT="json" # "json" | "console"

# --- AGENT ORCHESTRATION LIMITS ---
MAX_ORCHESTRATION_CYCLES=12
MAX_SUBTASKS_PER_OBJECTIVE=10
AUTO_APPROVE_LOW_RISK=true
REQUIRE_APPROVAL_HIGH_RISK=true

